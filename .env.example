# ==========================================
# PolicyBot HR - Variables de Entorno
# ==========================================

# Servidor Backend
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Seguridad y JWT
JWT_SECRET=CAMBIAR_ESTE_SECRETO_EN_PRODUCCION_MIN_32_CARACTERES
JWT_EXPIRES_IN=8h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=policybot_rrhh

# Inteligencia Artificial - DeepSeek (API compatible con OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_TEMPERATURE=0.2

# RAG - Base Vectorial Qdrant & Embeddings Ollama (BGE-M3)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policybot_hr_docs
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine
RAG_ALLOW_LOCAL_VECTOR_FALLBACK=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
RAG_SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=8

# Google Drive API (OAuth 2.0 Web Client o Service Account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/documents/drive/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Automatización Cron
CRON_SCHEDULE=0 7 * * *
CRON_TIMEZONE=America/Costa_Rica
